        <mxCell id="finding" parent="1" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;fontColor=#18333e;strokeColor=#4d7682;fillColor=#ffffff;align=left;" value="&lt;b&gt;Finding:&lt;/b&gt;&amp;nbsp;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;Report &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;CJ-603 &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;was &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;supposed &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;to &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;go &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;to s&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;tructures &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;because &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;it &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;was &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;for &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;a &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;bridge, &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;but &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;it &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;went &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;to e&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;lectrical &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;instead. &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;The &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;report &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;was &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;accepted &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;but &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;sent &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;to &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;the &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;wrong &lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211)); background-color: transparent;&quot;&gt;department.&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Unanswered question:&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211));&quot;&gt;Why did the bridge report go to electrical instead of structures? &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211));&quot;&gt;We &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211));&quot;&gt;would &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211));&quot;&gt;need &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211));&quot;&gt;to &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211));&quot;&gt;check &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211));&quot;&gt;the &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211));&quot;&gt;routing &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211));&quot;&gt;table &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211));&quot;&gt;to see&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211));&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211));&quot;&gt;why &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211));&quot;&gt;it &lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(24, 51, 62), rgb(178, 202, 211));&quot;&gt;happened.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;p&gt;Sources: W06-S02, W06-S03, W06-S04&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
